# Remote PostgreSQL; copy to .env and supply your own password. Never commit .env.
POSTGRE_DSN='host=db-server user=postgres password=REPLACE_ME dbname=lockgate port=5432 sslmode=disable connect_timeout=10'
LOCKGATE_BIND=0.0.0.0
LOCKGATE_PORT=18430
LOCKGATE_ORIGIN=http://db-server:18430
# Direct HTTP requires this opt-in. Set false when using an HTTPS reverse proxy.
LOCKGATE_INSECURE_DEV_COOKIES=true
LOCKGATE_UID=1000
LOCKGATE_GID=1000
